<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="357.0" prefWidth="475.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.senecapolytechnic.hotelreservationsystem.controller.AdminDashboardController">
   <children>
      <VBox prefHeight="357.0" prefWidth="475.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="39.0" prefWidth="475.0" style="-fx-background-color: brown;">
               <children>
                  <Button fx:id="backButton" minHeight="-Infinity" mnemonicParsing="false" onAction="#handleBack" prefHeight="29.0" prefWidth="52.0" text="Back">
                     <font>
                        <Font name="Dubai Regular" size="14.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="5.0" />
                     </HBox.margin>
                  </Button>
               </children></HBox>
            <VBox alignment="CENTER" prefHeight="320.0" prefWidth="475.0">
               <children>
                  <Label text="Admin Dashboard">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="15.0" />
                     </VBox.margin>
                  </Label>
                  <VBox prefHeight="301.0" prefWidth="600.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="580.0">
                           <children>
                              <Label prefHeight="25.0" prefWidth="137.0" text="Reservations">
                                 <font>
                                    <Font name="System Bold" size="16.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="searchTextField" onKeyTyped="#handleSearch" promptText="Search...">
                                 <HBox.margin>
                                    <Insets left="250.0" />
                                 </HBox.margin>
                              </TextField>
                           </children>
                        </HBox>
                        <TableView fx:id="allReservationsTable" prefHeight="183.0" prefWidth="580.0">
                           <columns>
                              <TableColumn fx:id="nameCol" prefWidth="170.00003051757812" text="Name" />
                              <TableColumn fx:id="phoneCol" prefWidth="171.99993896484375" text="Phone" />
                              <TableColumn fx:id="reservationIDCol" prefWidth="113.3333740234375" text="Reservation ID" />
                           </columns>
                        </TableView>
                     </children>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </VBox>
                  <HBox alignment="CENTER" prefHeight="49.0" prefWidth="475.0">
                     <children>
                        <Button fx:id="newBookingButton" mnemonicParsing="false" onAction="#handleNewBooking" text="New Booking">
                           <font>
                              <Font name="Dubai Regular" size="14.0" />
                           </font>
                           <HBox.margin>
                              <Insets right="15.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="modifyBookingButton" mnemonicParsing="false" onAction="#handleModifyBooking" text="Modify Booking">
                           <font>
                              <Font name="Dubai Regular" size="14.0" />
                           </font>
                           <HBox.margin>
                              <Insets right="15.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="checkoutButton" mnemonicParsing="false" onAction="#handleCheckout" text="Checkout">
                           <font>
                              <Font name="Dubai Regular" size="14.0" />
                           </font>
                           <HBox.margin>
                              <Insets right="15.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="cancelBookingButton" mnemonicParsing="false" onAction="#handleCancelBooking" text="Cancel Booking">
                           <font>
                              <Font name="Dubai Regular" size="14.0" />
                           </font>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
